{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "openai/gpt-6.1-sol",
  "instructions": ["~/.config/opencode/AGENTS.md", "./AGENTS.MD"],
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-terra": {
          "settings": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-6-luna": {
          "settings": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-6-astra": {
          "settings": {
            "reasoningEffort": "medium"
          }
        }
      }
    },
    "polza": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://polza.ai/api/v1",
        "apiKey": "{file:~/.secrets/opencode/polza-ai}"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek v4.1 Flash"
        },
        "deepseek/deepseek-v4-flash-0731": {
          "name": "DeepSeek v4 Flash 0731"
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek v4 Flash"
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://{env:OLLAMA_HOST}:11434/v1"
      },
      "models": {
        "SparkLLM/Spark-X2.5-1.7B:latest": {
          "name": "Spark X2.5 1.7B"
        },
        "qwen3:14b": {
          "name": "Qwen 3 14B"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 coder 7b"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "ssh": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "slepp-ssh-mcp",
          "ssh-mcp"
        ],
      }
    }
  },
  "agents": {
    "build": {
      "model": "openai/gpt-6.1-sol#medium"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol#medium"
    },
    "general": {
      "model": "openai/gpt-5.6-terra#medium"
    },
    "explore": {
      "model": "openai/gpt-6-luna#low"
    },
    "patch": {
      "mode": "primary",
      "model": "openai/gpt-6-luna#medium"
    },
    "coder": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#medium"
    },
  }
}